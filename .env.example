# ─────────────────────────────────────────────────────────────
# 애플리케이션 환경 변수 (견적서 웹뷰어)
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# ─────────────────────────────────────────────────────────────

# Notion Integration (서버 전용 — 절대 NEXT_PUBLIC_ 접두사 사용 금지)
#   발급: https://www.notion.so/my-integrations → New integration
#   생성한 integration을 Quote/LineItem DB에 "연결(공유)"해야 합니다.
NOTION_TOKEN=

# Notion 견적서(Quote) Database ID (32자 hex, 하이픈 제거 형태 권장)
NOTION_QUOTE_DB_ID=

# Notion 항목(LineItem) Database ID
NOTION_LINE_ITEM_DB_ID=

# 배포 URL (OG 메타/절대경로 생성용, 선택)
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────
# Claude Code 훅용 Slack Incoming Webhook URL (앱과 무관, 선택)
#
# 발급 방법:
#   1. https://api.slack.com/apps → Create New App → From scratch
#   2. Incoming Webhooks 토글 On → Add New Webhook to Workspace → 채널 선택
#   3. 생성된 URL을 아래에 붙여넣고 이 파일을 .env 로 복사하세요.
# 예시 형식: https://hooks.slack.com/services/T.../B.../xxxx
# ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
