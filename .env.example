# Claude Code 훅용 Slack Incoming Webhook URL
#
# 발급 방법:
#   1. https://api.slack.com/apps → Create New App → From scratch
#   2. Incoming Webhooks 토글 On → Add New Webhook to Workspace → 채널 선택
#   3. 생성된 URL을 아래에 붙여넣고 이 파일을 .env 로 복사하세요.
#
# 모바일 푸시를 받으려면 Slack 모바일 앱에서 해당 채널 알림을 "모든 메시지"로 설정하세요.
#
# 예시 형식: https://hooks.slack.com/services/T.../B.../xxxx
SLACK_WEBHOOK_URL=
